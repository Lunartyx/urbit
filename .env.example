# Copy to .env.local for development; use Azure application secrets in production.
SITE_URL=https://urbit.ch
ENQUIRY_ENABLED=false
ENQUIRY_DELIVERY_VERIFIED=false
ENQUIRY_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SMTP_HOST=REPLACE_WITH_PROVIDER_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM=REPLACE_WITH_VERIFIED_SENDER_EMAIL
MAIL_TO=REPLACE_WITH_DESTINATION_EMAIL
REDIS_URL=rediss://REPLACE_WITH_AUTHENTICATED_REDIS_ENDPOINT
# Local development only. Shows controls but never bypasses server delivery gates.
ENQUIRY_FORM_PREVIEW=false
